# Base URLs for services. These can be replaced with a custom domain or
# a tunneling service URL (e.g., ngrok) to make the app accessible externally.
# Example: KEYCLOAK_URL=https://abc-123.ngrok-free.app/auth
# NOTE: If changed, update "Valid Redirect URIs" and "Web Origins" in Keycloak.

KEYCLOAK_URL=http://localhost/auth
FRONTEND_URL=http://localhost
API_URL=http://localhost/api